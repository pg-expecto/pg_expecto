# param.conf.low
# НАСТРОЙКИ НАГРУЗОЧНОГО ТЕСТИРОВАНИЯ
# РЕЖИМ LOW
# Начальная нагрузка
start_load = 1
# Максимальная нагрузка
finish_load = 1

# Тестовая БД
testdb = default
# testdb = demo

# Тип синтетической нагрузки
load_mode = oltp

# ОДИН ПРОХОД = 1 ЧАС.
period_hours = 1
average_load = 1
# Имитация инцидента - vacuum
vacuum_incident = 0

# Веса сценариев по умолчанию
scenario1 = -1
scenario2 = -1
scenario3 = -1

# Инициализировать тестовую БД
init_test_db = on


#~100MB
scale = 20
